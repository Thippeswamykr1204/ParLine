POSTGRES_PASSWORD=change-me
API_KEY=change-me            # protects POST/heavy endpoints via X-API-Key; empty disables auth (dev only)
CORS_ORIGINS=http://localhost:3000
SCHEDULE_UTC=02:00

# --- Tier 7 agent: Groq (free tier, fast inference) ---
# Get a free key: https://console.groq.com/keys
AGENT_PROVIDER=groq
GROQ_API_KEY=YOUR_API_KEY

# Optional: override the Groq model. Blank = llama-3.3-70b-versatile (see backend/app/agent/llm.py).
AGENT_MODEL=Deafault_model
