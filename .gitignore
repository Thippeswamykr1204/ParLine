# ── Secrets — never commit real env files ──────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local

# ── Python (backend) ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# ── Node / Next.js (frontend) ───────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
frontend/node_modules/
frontend/.next/
frontend/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Data & generated artifacts ──────────────────────────────────────────
# Keep raw source data and seed CSVs, but ignore anything regenerated by
# the pipeline (models, run outputs, synced frontend copies) so it doesn't
# bloat the repo or go stale in version control.
data/processed/*.tmp
models/*.pkl
models/*.joblib
frontend/public/data/*.csv.bak
*.parquet.tmp

# ── Database ─────────────────────────────────────────────────────────────
*.sqlite3
pgdata/
postgres-data/

# ── OS / Editor cruft ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Docker ────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Misc build/test output ──────────────────────────────────────────────
coverage/
.coverage
htmlcov/
dist/
build/