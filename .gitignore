# ── Secrets: never commit real env files (keep .env.example tracked) ──────
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key

# ── Python (backend / notebooks) ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.log

# ── Node / Next.js (frontend) ─────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/

# ── Generated / temporary artifacts ───────────────────────────────────────
# Raw data and pipeline CSVs in data/raw and data/processed ARE tracked: the Docker
# image seeds Postgres from them and the frontend build copies them (sync-data).
data/processed/*.tmp
data/incoming/*
!data/incoming/.gitkeep
models/*.pkl
models/*.joblib
frontend/public/data/*.csv.bak
*.parquet.tmp

# ── Database ──────────────────────────────────────────────────────────────
*.sqlite3
pgdata/
postgres-data/

# ── Docker / local overrides ──────────────────────────────────────────────
docker-compose.override.yml

# ── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Misc build/test output ────────────────────────────────────────────────
coverage/
.coverage
htmlcov/
dist/
build/